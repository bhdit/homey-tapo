{
  "title": {
    "en": "Turn off for a while"
  },
  "titleFormatted": {
    "en": "Turn off for [[duration]] seconds"
  },
  "hint": {
    "en": "Afterwards the light returns to exactly how it was — colour, brightness, effect and on/off. Changing the light in the meantime cancels the return."
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=L510|L900|L920|L930"
    },
    {
      "type": "number",
      "name": "duration",
      "min": 1,
      "max": 86400,
      "step": 1,
      "placeholder": {
        "en": "Seconds"
      }
    }
  ]
}
